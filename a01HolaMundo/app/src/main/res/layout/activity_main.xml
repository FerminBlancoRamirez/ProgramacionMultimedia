<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/soft_yellow">

    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:id="@+id/iVEsquinaSUperiorIzquierda"
        android:src="@drawable/estilo_de_borde"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:rotation="90"/>

    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:id="@+id/iVEsquinaSUperiorDerecha"
        android:src="@drawable/estilo_de_borde"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:rotation="180"/>

    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:id="@+id/iVEsquinaInferiorIzquierda"
        android:src="@drawable/estilo_de_borde"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:id="@+id/iVEsquinaInferiorDerecha"
        android:src="@drawable/estilo_de_borde"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:rotation="270"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mCSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/dark_blue"
        android:layout_marginTop="70dp">

        <TextView
            android:id="@+id/tVSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Saludo"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:padding="20dp"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mCPresentacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/mCSaludo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/dark_blue"
        android:layout_marginTop="40dp">

        <TextView
            android:id="@+id/tVPresentacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Presentacion"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:padding="20dp"/>

    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/iVLibroMundo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/mCPresentacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mBSalida"
        android:src="@drawable/dia_mundial_del_libro"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mBSalida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="70dp"
        android:backgroundTint="@color/dark_blue"
        android:text="@string/textoBoton"
        android:padding="20dp"
        app:icon="@drawable/cerrar_sesion"
        android:textSize="20dp"
        app:iconSize="40dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>